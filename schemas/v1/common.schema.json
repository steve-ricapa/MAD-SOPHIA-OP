{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.txdxsecure.com/etl/v1/common.schema.json",
  "title": "TXDX ETL V2 common definitions",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "severity": {
      "type": "string",
      "enum": ["unknown", "info", "low", "medium", "high", "critical"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instance_id"],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "instance_id": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_version",
        "mapping_version",
        "policy_version",
        "collected_at",
        "raw_record_hash"
      ],
      "properties": {
        "connector_version": { "$ref": "#/$defs/version" },
        "mapping_version": { "$ref": "#/$defs/version" },
        "policy_version": { "$ref": "#/$defs/version" },
        "collected_at": { "$ref": "#/$defs/timestamp" },
        "raw_record_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason_code", "policy_version", "decided_at"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["accepted", "rejected", "quarantined"]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        },
        "policy_version": { "$ref": "#/$defs/version" },
        "decided_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "ip": {
          "type": "string",
          "anyOf": [
            { "format": "ipv4" },
            { "format": "ipv6" }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "attributes": {
      "type": "object",
      "maxProperties": 50,
      "additionalProperties": true
    }
  }
}
