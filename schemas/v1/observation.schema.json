{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.txdxsecure.com/etl/v1/observation.schema.json",
  "title": "Canonical observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "record_id",
    "asset_id",
    "source_object_id",
    "observation_type",
    "kind",
    "status",
    "observed_at",
    "decision",
    "provenance"
  ],
  "properties": {
    "record_type": { "const": "observation" },
    "record_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "asset_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "source_object_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "observation_type": {
      "type": "string",
      "enum": ["availability", "latency", "uptime", "certificate", "metric", "state"]
    },
    "kind": {
      "type": "string",
      "enum": ["initial", "change", "refresh", "discovered", "disappeared"]
    },
    "status": {
      "$ref": "#/$defs/observationStatus"
    },
    "previous_status": {
      "$ref": "#/$defs/observationStatus"
    },
    "observed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "source_event_time": { "$ref": "common.schema.json#/$defs/timestamp" },
    "target": { "$ref": "common.schema.json#/$defs/endpoint" },
    "measurements": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/measurement" }
    },
    "attributes": { "$ref": "common.schema.json#/$defs/attributes" },
    "decision": { "$ref": "common.schema.json#/$defs/decision" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  },
  "$defs": {
    "observationStatus": {
      "type": "string",
      "enum": ["up", "down", "pending", "maintenance", "available", "unavailable", "valid", "invalid", "present", "absent", "unknown"]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        },
        "value": {
          "type": ["number", "integer", "boolean", "string"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "window": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  }
}
