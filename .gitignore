**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# -----------------------------
# Logs and OS/editor junk
# -----------------------------
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

