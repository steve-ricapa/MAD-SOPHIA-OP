# ============================================================
# ENV GENERAL - MAD-SOPHIA-OP (EJEMPLO)
# ============================================================
# Copia este archivo a `.env` y completa los valores marcados
# como replace_me. Este archivo consolida las 6 integraciones:
# 1) Wazuh
# 2) Zabbix
# 3) OpenVAS
# 4) InsightVM
# 5) Uptime Kuma
# 6) Nessus
#
# Tenants de XOC:
#   1 -> XOC Demo
#   4 -> DemoCorp
#   7 -> Mi Fibra
#   8 -> XOC APPLIANCE
#
# IMPORTANTE:
# - Este archivo refleja el contrato actual de XOC/AWS.
# - Los agentes cargan el .env raiz de forma determinista.
# - TXDXAI_TENANT_ID / TXDXAI_COMPANY_ID son globales (una sola vez).
# ============================================================

# ============================================================
# VARIABLES GLOBALES COMUNES (SHARED)
# ============================================================
TXDXAI_INGEST_URL=https://xvwg3cvl6b.execute-api.us-east-1.amazonaws.com/scans/upload-url
TXDXAI_TENANT_ID=7
TXDXAI_COMPANY_ID=7
OUTPUT_MODE=all
QUEUE_ENABLED=true
QUEUE_FLUSH_MAX=20


# ============================================================
# 1) WAZUH INTEGRATION
# Ruta runtime: runtime/wazuh
# ============================================================
# Wazuh Indexer (OpenSearch)
WAZUH_INDEXER_HOST=https://your-wazuh-indexer:9200
WAZUH_INDEXER_USER=wazuh-xoc-mf
WAZUH_INDEXER_PASSWORD=replace_me
WAZUH_INDEXER_VERIFY_TLS=False

# Wazuh Server API
WAZUH_API_HOST=https://your-wazuh-server:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=replace_me
WAZUH_API_VERIFY_TLS=False

# Backend Integration
TXDXAI_API_KEY_WAZUH=replace_me

# Agent Configuration (prefijadas)
WAZUH_OUTPUT_MODE=all
WAZUH_POLL_INTERVAL_ALERTS=60
WAZUH_POLL_INTERVAL_AGENTS=600
WAZUH_RETRY_FAILED_INTERVAL_SECONDS=60
WAZUH_HEARTBEAT_EMPTY_CYCLES=10
MIN_RULE_LEVEL=7
CHECKPOINT_FILE=state/agent_state.db
LOG_LEVEL=DEBUG
INITIAL_LOOKBACK_HOURS=2
ALERT_BATCH_SIZE=500
DEDUP_RETENTION_DAYS=7
SEND_HEARTBEAT=false
ARTIFACTS_DIR=artifacts
WAZUH_ARTIFACTS_DIR=runtime/wazuh/artifacts

# Observability
HEALTH_CHECK_PORT=8080

# Debug / Development
DRY_RUN=false
WAZUH_API_ENABLED=true


# ============================================================
# 2) ZABBIX INTEGRATION
# Ruta runtime: runtime/zabbix
# ============================================================
# Zabbix Source
ZABBIX_API_URL=https://your-zabbix/api_jsonrpc.php
ZABBIX_USER=zabbix-xoc-mf
ZABBIX_PASS=replace_me

# Variables prefijadas de Zabbix
ZABBIX_OUTPUT_MODE=all
ZABBIX_HOURS=24
ZABBIX_INTERVAL=180
ZABBIX_VERIFY_SSL=false
ZABBIX_REQUEST_TIMEOUT=120
ZABBIX_HTTP_RETRIES=3
ZABBIX_BACKOFF_SECONDS=5
ZABBIX_PROBLEMS_LIMIT=600
ZABBIX_TRIGGERS_LIMIT=1000
ZABBIX_EVENTS_LIMIT=2000
ZABBIX_INCLUDE_EVENTS=true
DIAGNOSTIC_TIMEOUT=600
ZABBIX_API_TOKEN=replace_me

# TxDxAI (Backend)
TXDXAI_API_KEY_ZABBIX=replace_me

# Configuracion de estado prefijada
ZABBIX_STATE_FILE=state.json
ZABBIX_DEBUG_REPORT_PATH=debug_report.json
ZABBIX_LAST_PAYLOAD_PATH=last_payload_sent.json
ZABBIX_QUEUE_DIR=runtime/zabbix/queue


# ============================================================
# 3) OPENVAS INTEGRATION
# Ruta runtime: runtime/openvas
# ============================================================
# Agent configuration
OPENVAS_OUTPUT_MODE=http
OPENVAS_COLLECTOR=gmp
OPENVAS_POLL_SECONDS=600
OPENVAS_STATE_PATH=./state.json
META_MAX_KB=900
PYTHONDONTWRITEBYTECODE=1

OPENVAS_DETAIL_LEVEL=findings
OPENVAS_TOP_N=2000
OPENVAS_REPORT_MAX_KB=20000
OPENVAS_FINDING_TEXT_MAX=300
OPENVAS_DEBUG=false
OPENVAS_MAX_ERROR_REPEAT=3

# OpenVAS / Greenbone (GVMD) - despliegue MAD centralizado (remoto)
# Cliente actual expone GMP en TCP plano (sin TLS)
GVM_TRANSPORT=plain
GVM_ALLOW_PLAIN_TCP=true
#GVM_SOCKET=
GVM_USERNAME=openvas-xoc-mf
GVM_PASSWORD=replace_me

# Host/puerto GMP remoto
GVM_HOST=your-gvm-host
GVM_PORT=41000
GVM_USE_TLS=false

# TxDxAI (Backend)
TXDXAI_API_KEY_OPENVAS=replace_me

# Si el backend tiene cert raro/self-signed, pon false.
BACKEND_TLS_VERIFY=false
OPENVAS_ARTIFACTS_DIR=runtime/openvas/artifacts


# ============================================================
# 4) INSIGHTVM INTEGRATION
# Ruta runtime: runtime/insightvm
# ============================================================
INSIGHTVM_USER=xoc-mf-insight
INSIGHTVM_PASSWORD=replace_me
INSIGHTVM_BASE_URL=https://your-insightvm:3780/api/3
INSIGHTVM_VERIFY_SSL=false

# TxDxAI (Backend)
TXDXAI_API_KEY_INSIGHTVM=replace_me

# Configuracion prefijada de InsightVM
INSIGHTVM_OUTPUT_MODE=all
INSIGHTVM_INTERVAL_SECONDS=600
INSIGHTVM_STATE_FILE=runtime/insightvm/state.json
INSIGHTVM_QUEUE_DIR=runtime/insightvm/queue


# ============================================================
# 5) UPTIME KUMA INTEGRATION
# Ruta runtime: runtime/uptimekuma
# ============================================================
# Uptime Kuma source
UPTIME_KUMA_URL=http://your-uptime-kuma:35923
UPTIME_KUMA_METRICS_PATH=/metrics
UPTIME_KUMA_DB_PATH=/var/lib/docker/volumes/uptime-kuma/_data/kuma.db

# Option A: basic auth (disable API Keys in Uptime Kuma)
# UPTIME_KUMA_USERNAME=admin
# UPTIME_KUMA_PASSWORD=admin123

# Option B: API keys enabled in Uptime Kuma
UPTIME_KUMA_API_KEY_ID=1
UPTIME_KUMA_API_KEY=replace_me

# Agent runtime (prefijado)
UPTIME_OUTPUT_MODE=all
UPTIME_SCANNER_TYPE=uptime_kuma
UPTIME_POLL_INTERVAL_SECONDS=180
UPTIME_FORCE_SEND_EVERY_CYCLES=1
UPTIME_REQUEST_TIMEOUT=30
UPTIME_HTTP_RETRIES=3
UPTIME_BACKOFF_SECONDS=5
UPTIME_VERIFY_SSL=true
UPTIME_EVENT_TYPE=vuln_scan_report
UPTIME_QUEUE_ENABLED=true
UPTIME_QUEUE_DIR=runtime/uptimekuma/queue
UPTIME_QUEUE_FLUSH_MAX=20
UPTIME_RAW_SNAPSHOT_PATH=raw_monitors_snapshot.json
UPTIME_INCLUDE_ALL_MONITORS=true
UPTIME_INCLUDE_EXTENDED_FIELDS=true

# Backend target
TXDXAI_API_KEY_UPTIMEKUMA=replace_me


# ============================================================
# 6) NESSUS INTEGRATION
# Ruta runtime: runtime/nessus
# ============================================================
# Nessus source
NESSUS_BASE_URL=https://your-nessus:8834
NESSUS_ACCESS_KEY=replace_me
NESSUS_SECRET_KEY=replace_me
NESSUS_VERIFY_SSL=false
NESSUS_MAX_SCANS_PER_CYCLE=5
# Opcionales (filtrado)
NESSUS_SCAN_IDS=
NESSUS_FOLDER_ID=

# Agent runtime (prefijado)
NESSUS_OUTPUT_MODE=all
NESSUS_SCANNER_TYPE=nessus
NESSUS_POLL_INTERVAL_SECONDS=600
NESSUS_FORCE_SEND_EVERY_CYCLES=6
NESSUS_REQUEST_TIMEOUT=30
NESSUS_HTTP_RETRIES=3
NESSUS_BACKOFF_SECONDS=5
NESSUS_EVENT_TYPE=vuln_scan_report
NESSUS_QUEUE_ENABLED=true
NESSUS_QUEUE_DIR=runtime/nessus/queue
NESSUS_QUEUE_FLUSH_MAX=20
NESSUS_RAW_SNAPSHOT_PATH=raw_scans_snapshot.json
NESSUS_INCLUDE_ALL_FINDINGS=true

# Backend target
TXDXAI_API_KEY_NESSUS=replace_me
