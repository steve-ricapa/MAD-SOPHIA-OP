# Plantilla de configuracion del ETL local.
# Copia este archivo como ".env" en la raiz del proyecto y completa los valores.
# El archivo .env real NO se sube al repositorio (esta en .gitignore).
#
# Prioridad de lectura: flags del CLI > variables de entorno del sistema > .env

# Obligatorios
UPTIME_KUMA_URL=http://IP_DE_KUMA:3001
UPTIME_KUMA_USERNAME=tu_usuario
UPTIME_KUMA_PASSWORD=tu_contrasena

# Opcionales (valores por defecto abajo)
TXDX_ETL_DB=runtime/spool.db
TXDX_ETL_TENANT=1
TXDX_ETL_INSTANCE=kuma-lab
TXDX_ETL_DISPLAY_NAME=Uptime Kuma
TXDX_ETL_INTERVAL=30

# true solo para laboratorio en red local plana (HTTP sin TLS)
TXDX_ETL_ALLOW_INSECURE=true
