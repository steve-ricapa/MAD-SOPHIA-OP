# ============================================================
# ENV GENERAL - MAD-SOPHIA-OP (EJEMPLO)
# ============================================================
# Copia este archivo a `.env` y completa los valores marcados
# como replace_me. Este archivo consolida las 6 integraciones:
# 1) Wazuh
# 2) Zabbix
# 3) OpenVAS
# 4) InsightVM
# 5) Uptime Kuma
# 6) Nessus
#
# Tenants de XOC:
#   1 -> XOC Demo
#   4 -> DemoCorp
#   7 -> Mi Fibra
#   8 -> XOC APPLIANCE
#
# IMPORTANTE:
# - Este archivo refleja el contrato actual de XOC/AWS.
# - Los agentes cargan el .env raiz de forma determinista.
# - TXDXAI_TENANT_ID / TXDXAI_COMPANY_ID son globales (una sola vez).
# ============================================================

# ============================================================
# VARIABLES GLOBALES COMUNES (SHARED)
# ============================================================
# Endpoint HTTPS del backend que entrega la URL de subida del snapshot a S3.
TXDXAI_INGEST_URL=https://xvwg3cvl6b.execute-api.us-east-1.amazonaws.com/scans/upload-url
# Identificador del tenant enviado al backend; entero positivo.
TXDXAI_TENANT_ID=7
# Identificador de empresa del payload; entero positivo y fallback del tenant.
TXDXAI_COMPANY_ID=7
# Salida global de Nessus/Kuma/Zabbix: stdout, webhook o all; OpenVAS usa su propia opcion http/console.
OUTPUT_MODE=all
# Compatibilidad del transporte antiguo. No desactiva el journal durable delivery-v2 de los colectores actuales.
QUEUE_ENABLED=true
# Maximo de pendientes que se intenta drenar por llamada al journal en Nessus/Kuma/Zabbix/InsightVM; entero positivo.
QUEUE_FLUSH_MAX=20

# Common policy for all six: changes immediately, backup on sixth unchanged cycle.
# Count successful source checks only; reset after confirmed delivery.
# Remove legacy FORCE_SEND_EVERY_CYCLES / SNAPSHOT_ALWAYS_SEND settings.
# Politica comun de las seis: change_or_backup envia ante cambios y permite respaldo por ciclos.
MAD_DELIVERY_MODE=change_or_backup
# Consultas exitosas consecutivas sin cambios antes del respaldo; entrega confirmada reinicia el contador.
MAD_DELIVERY_BACKUP_CYCLES=6



# ============================================================
# ALMACENAMIENTO DE DIAGNOSTICO Y LOGS (COMUN A LAS SEIS)
# ============================================================
# false conserva solo las ultimas copias; true habilita historicos completos opcionales.
# Nunca desactiva estados, recibos ni payloads pendientes de entrega.
MAD_ARCHIVE_ENABLED=false
# Antiguedad maxima en dias de bundles administrados; se revisa durante ciclos/archivado.
MAD_ARCHIVE_RETENTION_DAYS=7
# Presupuesto de historicos en MiB por raiz administrada e integracion; no es limite de todo el disco.
MAD_ARCHIVE_MAX_MB=100
# Maximo de bundles (no archivos individuales) por raiz administrada e integracion.
MAD_ARCHIVE_MAX_ENTRIES=100
# Umbral de rotacion del log, en MiB. El log del orquestador puede crecer durante una ejecucion.
MAD_LOG_MAX_MB=5
# Maximo de archivos de log rotados conservados por flujo de log; no incluye el archivo activo.
MAD_LOG_BACKUP_COUNT=5
# Antiguedad maxima de logs rotados, en dias; se aplica en mantenimiento/rotacion.
MAD_LOG_RETENTION_DAYS=14

# Debug de payload: cada flag habilita copias adicionales solo para su transporte.
# Aunque MAD_ARCHIVE_ENABLED=false, un flag true fuerza un bundle con los mismos limites anteriores.
# false no guarda payloads extra de nessus; true habilita diagnostico acotado.
NESSUS_PAYLOAD_DEBUG=false
# Ruta opcional para ese diagnostico; cambiar la ruta no lo habilita por si solo.
# NESSUS_PAYLOAD_DEBUG_DIR=runtime/payload_debug/nessus
# false no guarda payloads extra de uptimekuma; true habilita diagnostico acotado.
UPTIME_PAYLOAD_DEBUG=false
# Ruta opcional para ese diagnostico; cambiar la ruta no lo habilita por si solo.
# UPTIME_PAYLOAD_DEBUG_DIR=runtime/payload_debug/uptimekuma
# false no guarda payloads extra de zabbix; true habilita diagnostico acotado.
ZABBIX_PAYLOAD_DEBUG=false
# Ruta opcional para ese diagnostico; cambiar la ruta no lo habilita por si solo.
# ZABBIX_PAYLOAD_DEBUG_DIR=runtime/payload_debug/zabbix
# false no guarda payloads extra de openvas; true habilita diagnostico acotado.
OPENVAS_PAYLOAD_DEBUG=false
# Ruta opcional para ese diagnostico; cambiar la ruta no lo habilita por si solo.
# OPENVAS_PAYLOAD_DEBUG_DIR=runtime/payload_debug/openvas
# false no guarda payloads extra de wazuh; true habilita diagnostico acotado.
WAZUH_PAYLOAD_DEBUG=false
# Ruta opcional para ese diagnostico; cambiar la ruta no lo habilita por si solo.
# WAZUH_PAYLOAD_DEBUG_DIR=runtime/payload_debug/wazuh
# false no guarda payloads extra de insightvm; true habilita diagnostico acotado.
INSIGHTVM_PAYLOAD_DEBUG=false
# Ruta opcional para ese diagnostico; cambiar la ruta no lo habilita por si solo.
# INSIGHTVM_PAYLOAD_DEBUG_DIR=runtime/payload_debug/insightvm

# ============================================================
# 1) WAZUH INTEGRATION
# Ruta runtime: runtime/wazuh
# ============================================================
# Wazuh Indexer (OpenSearch)
# URL del Indexer/OpenSearch desde el que MAD consulta las alertas de Wazuh.
WAZUH_INDEXER_HOST=https://your-wazuh-indexer:9200
# Usuario autenticado con acceso de lectura a los indices de alertas.
WAZUH_INDEXER_USER=wazuh-xoc-mf
# Secreto del usuario del Indexer; no incluir credenciales reales en Git.
WAZUH_INDEXER_PASSWORD=replace_me
# true valida el certificado TLS del Indexer; false omite esa validacion.
WAZUH_INDEXER_VERIFY_TLS=False

# Wazuh Server API
# URL de la API del servidor Wazuh para consultar agentes.
WAZUH_API_HOST=https://your-wazuh-server:55000
# Usuario de lectura de la API de Wazuh.
WAZUH_API_USER=wazuh-wui
# Secreto de la API de Wazuh; no es la clave del backend.
WAZUH_API_PASSWORD=replace_me
# true valida el certificado TLS de la API de Wazuh.
WAZUH_API_VERIFY_TLS=False

# Backend Integration
# Clave del backend exclusiva para WAZUH; no es una credencial del sensor.
TXDXAI_API_KEY_WAZUH=replace_me

# Agent Configuration (prefijadas)
# LEGACY sin lectura en el agente actual: no controla el envio; para previsualizar Wazuh usar DRY_RUN.
WAZUH_OUTPUT_MODE=all
# Segundos entre ciclos de alertas en modo continuo; --once ejecuta un solo ciclo.
WAZUH_POLL_INTERVAL_ALERTS=60
# Segundos entre consultas de agentes en modo continuo; no programa systemd.
WAZUH_POLL_INTERVAL_AGENTS=600
# Compatibilidad: se carga y registra, pero los reintentos actuales ocurren al inicio de cada ciclo de alertas.
WAZUH_RETRY_FAILED_INTERVAL_SECONDS=60
# LEGACY sin lectura en el agente actual; el respaldo comun depende de MAD_DELIVERY_BACKUP_CYCLES.
WAZUH_HEARTBEAT_EMPTY_CYCLES=10
# Nivel minimo de regla Wazuh incluido en el payload; las alertas inferiores se filtran.
MIN_RULE_LEVEL=7
# Ruta del estado SQLite de Wazuh; relativa al directorio de ejecucion si no es absoluta. Conservarla.
CHECKPOINT_FILE=state/agent_state.db
# Nivel de log de Wazuh: INFO para operacion normal; DEBUG aumenta detalle, no activa archivos historicos completos.
LOG_LEVEL=INFO
# Horas de ventana retrospectiva para buscar alertas Wazuh en cada ciclo.
INITIAL_LOOKBACK_HOURS=2
# Maximo de alertas solicitadas al Indexer por ciclo; puede limitar cobertura si se alcanza.
ALERT_BATCH_SIZE=500
# LEGACY sin lectura en el agente actual; no elimina raw_batches, payloads, logs ni journals.
DEDUP_RETENTION_DAYS=7
# LEGACY sin lectura en el agente actual; no modifica el respaldo comun por ciclos.
SEND_HEARTBEAT=false
# Directorio global de artefactos; las rutas especificas por integracion prevalecen.
ARTIFACTS_DIR=artifacts
# Separar estado y comprobantes de Nessus, Uptime Kuma y Zabbix.
# Raiz de las ultimas copias y estado de Nessus; relativa a la raiz del repositorio.
NESSUS_ARTIFACTS_DIR=runtime/nessus
# Raiz de las ultimas copias y estado de Kuma; relativa a la raiz del repositorio.
UPTIME_ARTIFACTS_DIR=runtime/uptimekuma
# Raiz de las ultimas copias y estado de Zabbix; relativa a la raiz del repositorio.
ZABBIX_ARTIFACTS_DIR=runtime/zabbix
# Wazuh resuelve esta ruta dentro de runtime/wazuh.
# Ruta de copias y journal Wazuh. Si es relativa, se resuelve dentro de runtime/wazuh; no repetir ese prefijo.
WAZUH_ARTIFACTS_DIR=artifacts

# Observability
# Puerto TCP local del healthcheck de Wazuh; el agente escucha en 0.0.0.0.
HEALTH_CHECK_PORT=8080

# Debug / Development
# Wazuh: true guarda previsualizacion sin enviar ni avanzar el estado de entrega; false habilita envio real.
DRY_RUN=false
# Habilita consultas de agentes a la API Wazuh; las alertas se consultan al Indexer por separado.
WAZUH_API_ENABLED=true


# ============================================================
# 2) ZABBIX INTEGRATION
# Ruta runtime: runtime/zabbix
# ============================================================
# Zabbix Source
# URL completa del endpoint JSON-RPC de Zabbix.
ZABBIX_API_URL=https://your-zabbix/api_jsonrpc.php
# Usuario de Zabbix para autenticacion cuando no se proporciona token.
ZABBIX_USER=zabbix-xoc-mf
# Secreto del usuario de Zabbix; con token configurado no se usa el login por usuario.
ZABBIX_PASS=replace_me

# Variables prefijadas de Zabbix
# stdout previsualiza; webhook envia; all envia y conserva salida del transporte.
ZABBIX_OUTPUT_MODE=all
# Horas de ventana retrospectiva para problemas y eventos de Zabbix.
ZABBIX_HOURS=24
# Segundos entre ciclos en modo continuo; no cambia el horario del temporizador systemd.
ZABBIX_INTERVAL=180
# true valida TLS al consultar Zabbix y al enviar con su transporte.
ZABBIX_VERIFY_SSL=false
# Timeout de las peticiones de Zabbix y su transporte, en segundos.
ZABBIX_REQUEST_TIMEOUT=120
# Numero configurado de intentos/reintentos HTTP del cliente y transporte Zabbix.
ZABBIX_HTTP_RETRIES=3
# Espera base de reintentos y pausa tras errores de ciclo, en segundos.
ZABBIX_BACKOFF_SECONDS=5
# Maximo de problemas solicitados por ciclo; alcanzar el limite puede producir cobertura parcial.
ZABBIX_PROBLEMS_LIMIT=600
# Maximo de triggers solicitados por ciclo; no es una opcion de guardado local.
ZABBIX_TRIGGERS_LIMIT=1000
# Maximo de eventos solicitados cuando ZABBIX_INCLUDE_EVENTS=true.
ZABBIX_EVENTS_LIMIT=2000
# Incluye consultas de eventos adicionales a problemas, hosts y triggers.
ZABBIX_INCLUDE_EVENTS=true
# LEGACY sin lectura en los colectores actuales; no establece el timeout real de una prueba.
DIAGNOSTIC_TIMEOUT=600
# Token de lectura de la API de Zabbix; prevalece sobre usuario/contrasena.
ZABBIX_API_TOKEN=replace_me

# TxDxAI (Backend)
# Clave del backend exclusiva para ZABBIX; no es una credencial del sensor.
TXDXAI_API_KEY_ZABBIX=replace_me

# Configuracion de estado prefijada
# Archivo de estado Zabbix; si es relativo se ubica dentro de ZABBIX_ARTIFACTS_DIR. Conservarlo.
ZABBIX_STATE_FILE=state.json
# Ultimo payload de diagnostico, sobrescrito; ruta relativa a ZABBIX_ARTIFACTS_DIR.
ZABBIX_DEBUG_REPORT_PATH=debug_report.json
# Ultimo payload intentado, sobrescrito; no es prueba de entrega sin su recibo.
ZABBIX_LAST_PAYLOAD_PATH=last_payload_sent.json
# Raiz de la cola/journal Zabbix; relativa a la raiz del repositorio. No limpiar como diagnostico.
ZABBIX_QUEUE_DIR=runtime/zabbix/queue


# ============================================================
# 3) OPENVAS INTEGRATION
# Ruta runtime: runtime/openvas
# ============================================================
# Agent configuration
# http envia al backend; console previsualiza sin confirmar entregas.
OPENVAS_OUTPUT_MODE=http
# gmp consulta Greenbone real; simulated genera datos de ejemplo y no confirma entregas reales.
OPENVAS_COLLECTOR=gmp
# Segundos entre ciclos OpenVAS en modo continuo; --once no espera otro ciclo.
OPENVAS_POLL_SECONDS=600
# Ruta del estado OpenVAS, relativa al directorio de ejecucion si no es absoluta. Conservarla.
OPENVAS_STATE_PATH=runtime/openvas/state.json
# Limite de XML de lista de tareas aceptado por OpenVAS, en KiB; no limita archivos historicos.
META_MAX_KB=900
# Python reconoce 1 al iniciar con esta variable exportada para evitar .pyc; cargarla tarde desde .env no basta.
PYTHONDONTWRITEBYTECODE=1

# Detalle del payload: summary, stats, findings, full o all; no habilita por si solo el archivo historico.
OPENVAS_DETAIL_LEVEL=findings
# Limite de hallazgos usado cuando GVM_FINDINGS_MAX/FINDINGS_MAX queda en -1; no cambia la retencion.
OPENVAS_TOP_N=2000
# Limite del XML al extraer contenido del reporte, en KiB; no reducir para ahorrar historicos sin revisar cobertura.
OPENVAS_REPORT_MAX_KB=20000
# Maximo de caracteres de texto por campo de hallazgo normalizado.
OPENVAS_FINDING_TEXT_MAX=300
# Salida de depuracion OpenVAS; no controla por si sola las copias historicas completas.
OPENVAS_DEBUG=false
# Veces que se imprime un mismo error antes de silenciar repeticiones; no son reintentos de envio.
OPENVAS_MAX_ERROR_REPEAT=3

# OpenVAS / Greenbone (GVMD) - despliegue MAD centralizado (remoto)
# Cliente actual expone GMP en TCP plano (sin TLS)
# Transporte GMP: plain (TCP sin TLS), tls o unix. Esta opcion decide la conexion real.
GVM_TRANSPORT=plain
# Permite explicitamente GMP plain; debe ser true para usar TCP sin TLS.
GVM_ALLOW_PLAIN_TCP=true
# Socket Unix GMP, solo con GVM_TRANSPORT=unix; sustituye host y puerto TCP.
# GVM_SOCKET=
# Usuario autenticado para consultar tareas y reportes Greenbone/GMP.
GVM_USERNAME=openvas-xoc-mf
# Secreto del usuario GMP; nunca incluir su valor real en el ejemplo versionado.
GVM_PASSWORD=replace_me

# Host/puerto GMP remoto
# Host o IP del servicio GMP remoto; se usa con plain o tls.
GVM_HOST=your-gvm-host
# Puerto TCP GMP del transporte plain/tls.
GVM_PORT=41000
# Compatibilidad: se parsea pero no selecciona el transporte actual; usar GVM_TRANSPORT.
GVM_USE_TLS=false

# TxDxAI (Backend)
# Clave del backend exclusiva para OPENVAS; no es una credencial del sensor.
TXDXAI_API_KEY_OPENVAS=replace_me

# Si el backend tiene cert raro/self-signed, pon false.
# Validacion TLS del transporte HTTP OpenVAS; true valida el certificado del backend.
BACKEND_TLS_VERIFY=false
# Raiz OpenVAS para ultimas copias y journal; relativa a la raiz del repositorio.
OPENVAS_ARTIFACTS_DIR=runtime/openvas/artifacts


# ============================================================
# 4) INSIGHTVM INTEGRATION
# Ruta runtime: runtime/insightvm
# ============================================================
# Usuario de lectura de la API de InsightVM.
INSIGHTVM_USER=xoc-mf-insight
# Secreto del usuario de InsightVM; separado de la clave del backend.
INSIGHTVM_PASSWORD=replace_me
# URL base de la API InsightVM, incluido /api/3.
INSIGHTVM_BASE_URL=https://your-insightvm:3780/api/3
# Valida TLS de InsightVM cuando true; puede ser sustituido por opciones CLI de la integracion.
INSIGHTVM_VERIFY_SSL=false

# TxDxAI (Backend)
# Clave del backend exclusiva para INSIGHTVM; no es una credencial del sensor.
TXDXAI_API_KEY_INSIGHTVM=replace_me

# Configuracion prefijada de InsightVM
# LEGACY sin lectura en el ejecutor actual; el backend se habilita con TXDXAI_INGEST_URL.
INSIGHTVM_OUTPUT_MODE=all
# Segundos entre ciclos InsightVM en modo continuo; --once ejecuta solo uno.
INSIGHTVM_INTERVAL_SECONDS=600
# Ruta del estado InsightVM; relativa a la raiz del repositorio. Conservarla.
INSIGHTVM_STATE_FILE=runtime/insightvm/state.json
# Raiz de pendientes/journal InsightVM; relativa a la raiz del repositorio.
INSIGHTVM_QUEUE_DIR=runtime/insightvm/queue


# ============================================================
# 5) UPTIME KUMA INTEGRATION
# Ruta runtime: runtime/uptimekuma
# ============================================================
# Uptime Kuma source
# URL base del Kuma real consultado; no es la ruta de su base SQLite.
UPTIME_KUMA_URL=http://your-uptime-kuma:35923
# Ruta HTTP de metricas Prometheus, combinada con UPTIME_KUMA_URL.
UPTIME_KUMA_METRICS_PATH=/metrics
# SQLite local opcional accesible desde MAD, abierto en solo lectura; ausente permite metricas sin enriquecimiento.
UPTIME_KUMA_DB_PATH=/var/lib/docker/volumes/uptime-kuma/_data/kuma.db

# Option A: basic auth (disable API Keys in Uptime Kuma)
# Usuario de metricas por autenticacion basica cuando Kuma no usa API keys.
# UPTIME_KUMA_USERNAME=admin
# Secreto de metricas por autenticacion basica; no habilitar junto a las API keys.
# UPTIME_KUMA_PASSWORD=replace_me

# Option B: API keys enabled in Uptime Kuma
# Identificador de la API key de metricas Kuma; usado como usuario de autenticacion basica.
UPTIME_KUMA_API_KEY_ID=1
# Secreto de metricas Kuma asociado al ID; no es la clave del backend.
UPTIME_KUMA_API_KEY=replace_me

# Agent runtime (prefijado)
# stdout previsualiza; webhook envia; all envia y conserva salida del transporte.
UPTIME_OUTPUT_MODE=all
# Identificador scanner_type del payload de Kuma.
UPTIME_SCANNER_TYPE=uptime_kuma
# Segundos entre ciclos Kuma en modo continuo; no cambia el temporizador systemd.
UPTIME_POLL_INTERVAL_SECONDS=180
# Timeout de consulta de metricas y transporte Kuma, en segundos.
UPTIME_REQUEST_TIMEOUT=30
# Numero configurado de intentos/reintentos HTTP para metricas y transporte Kuma.
UPTIME_HTTP_RETRIES=3
# Espera base de reintentos y pausa ante errores de ciclo, en segundos.
UPTIME_BACKOFF_SECONDS=5
# Validacion TLS de las peticiones de Kuma y de su transporte.
UPTIME_VERIFY_SSL=true
# event_type incluido en el contrato del payload; no determina si hubo cambio real.
UPTIME_EVENT_TYPE=vuln_scan_report
# Compatibilidad del transporte antiguo; el journal delivery-v2 permanece activo para no perder pendientes.
UPTIME_QUEUE_ENABLED=true
# Raiz de pendientes/journal Kuma; relativa a la raiz del repositorio.
UPTIME_QUEUE_DIR=runtime/uptimekuma/queue
# Maximo de pendientes Kuma que se intenta drenar por llamada al journal.
UPTIME_QUEUE_FLUSH_MAX=20
# Ultima copia de monitores crudos, sobrescrita; relativa a UPTIME_ARTIFACTS_DIR.
UPTIME_RAW_SNAPSHOT_PATH=raw_monitors_snapshot.json
# Incluye todos los monitores en el reporte preparado, aunque no hayan cambiado de estado.
UPTIME_INCLUDE_ALL_MONITORS=true
# Incluye campos ampliados de monitor; su disponibilidad depende de metricas y SQLite opcional.
UPTIME_INCLUDE_EXTENDED_FIELDS=true

# Backend target
# Clave del backend exclusiva para UPTIMEKUMA; no es una credencial del sensor.
TXDXAI_API_KEY_UPTIMEKUMA=replace_me


# ============================================================
# 6) NESSUS INTEGRATION
# Ruta runtime: runtime/nessus
# ============================================================
# Nessus source
# URL base de la API Nessus, incluido el puerto HTTPS.
NESSUS_BASE_URL=https://your-nessus:8834
# Clave de acceso de la API Nessus, distinta de la clave del backend.
NESSUS_ACCESS_KEY=replace_me
# Clave secreta asociada al acceso API Nessus.
NESSUS_SECRET_KEY=replace_me
# Validacion TLS de las consultas de Nessus y su transporte.
NESSUS_VERIFY_SSL=false
# Maximo de scans considerados por ciclo; no es un limite de archivos historicos.
NESSUS_MAX_SCANS_PER_CYCLE=5
# Opcionales (filtrado)
# Filtro opcional de IDs de scans separados por coma; vacio no filtra por ID.
NESSUS_SCAN_IDS=
# Filtro opcional por carpeta Nessus; vacio no filtra por carpeta.
NESSUS_FOLDER_ID=

# Agent runtime (prefijado)
# stdout previsualiza; webhook envia; all envia y conserva salida del transporte.
NESSUS_OUTPUT_MODE=all
# Identificador scanner_type del payload de Nessus.
NESSUS_SCANNER_TYPE=nessus
# Segundos entre ciclos Nessus en modo continuo; --once no espera el siguiente.
NESSUS_POLL_INTERVAL_SECONDS=600
# Timeout de consultas Nessus y transporte, en segundos.
NESSUS_REQUEST_TIMEOUT=30
# Numero configurado de intentos/reintentos HTTP Nessus y transporte.
NESSUS_HTTP_RETRIES=3
# Espera base de reintentos y pausa tras errores, en segundos.
NESSUS_BACKOFF_SECONDS=5
# event_type incluido en el payload de Nessus.
NESSUS_EVENT_TYPE=vuln_scan_report
# Compatibilidad del transporte antiguo; no desactiva el journal durable delivery-v2.
NESSUS_QUEUE_ENABLED=true
# Raiz de pendientes/journal Nessus; relativa a la raiz del repositorio.
NESSUS_QUEUE_DIR=runtime/nessus/queue
# Maximo de pendientes Nessus que se intenta drenar por llamada al journal.
NESSUS_QUEUE_FLUSH_MAX=20
# Ultima copia de scans crudos, sobrescrita; relativa a NESSUS_ARTIFACTS_DIR.
NESSUS_RAW_SNAPSHOT_PATH=raw_scans_snapshot.json
# Incluye hallazgos de todos los scans recolectados, no solo los considerados nuevos por el estado previo.
NESSUS_INCLUDE_ALL_FINDINGS=true
# Export per scan (CVE/CVSS/host/port reales). Si falla, usa resumen con defaults.
# Descarga export Nessus para obtener hallazgos reales; el archivo no se archiva como historico por esta opcion.
NESSUS_ENABLE_EXPORT=true
# Espera en segundos entre consultas del estado de una exportacion Nessus.
NESSUS_EXPORT_POLL_SECONDS=5
# Maximo de consultas hasta que una exportacion Nessus este lista.
NESSUS_EXPORT_POLL_ATTEMPTS=24
# Si export no disponible (p. ej. Nessus "Essentials Plus" -> HTTP 400),
# enriquece por detalle de plugin (/scans/{id}/vulnerabilities/{plugin_id}).
# Consulta detalle de plugins como alternativa cuando el export no esta disponible.
NESSUS_PLUGIN_DETAIL=true

# Backend target
# Clave del backend exclusiva para NESSUS; no es una credencial del sensor.
TXDXAI_API_KEY_NESSUS=replace_me

# Opciones del despliegue base 69cef37.
