[Unit]
Description=MAD-SOPHIA-OP: recoleccion horaria de las 5 integraciones (Nessus, Uptime Kuma, Zabbix, OpenVAS, Wazuh)
# El timer mad-6x.timer lo dispara. Ajusta ruta si el repo vive en otro lugar.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/steve-ricapa/DESARROLLO/MAD-SOPHIA-OP
ExecStart=/bin/bash /home/steve-ricapa/DESARROLLO/MAD-SOPHIA-OP/scripts/run_hourly.sh
Restart=no
# Tiempo maximo razonable para una recoleccion horaria completa.
TimeoutStartSec=1800
# Proteccion del sistema.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/steve-ricapa/DESARROLLO/MAD-SOPHIA-OP/runtime
ReadWritePaths=/home/steve-ricapa/DESARROLLO/MAD-SOPHIA-OP/artifacts
ReadWritePaths=/home/steve-ricapa/DESARROLLO/MAD-SOPHIA-OP/state
